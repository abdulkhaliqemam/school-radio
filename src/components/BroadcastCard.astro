---
import type { Broadcast } from '../lib/fetchBroadcasts';
import { toImageUrl } from '../lib/driveHelpers';

interface Props {
  broadcast: Broadcast;
}

const { broadcast } = Astro.props;
const coverUrl = toImageUrl(broadcast.cover, 600);
const broadcastUrl = `/school-radio/${broadcast.date.split('-')[0]}/${broadcast.date.split('-')[1]}/${broadcast.id}`;
---

<a href={broadcastUrl} class="group bg-white/80 backdrop-blur-md rounded-3xl shadow-lg hover:shadow-2xl transition-all duration-500 overflow-hidden flex flex-col border border-white/60 transform hover:-translate-y-2 h-full">
  <div class="relative aspect-video overflow-hidden bg-emerald-900/10">
    <img 
      src={coverUrl} 
      alt={broadcast.title} 
      loading="lazy"
      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
    />
    {broadcast.video && (
      <div class="absolute inset-0 bg-emerald-900/40 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300">
        <div class="bg-white/90 rounded-full p-4 transform scale-75 group-hover:scale-100 transition-transform duration-300 shadow-xl">
          <svg class="w-10 h-10 text-orange-500 ml-1" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd"></path></svg>
        </div>
      </div>
    )}
  </div>
  <div class="p-6 flex-grow flex flex-col">
    <div class="flex items-center gap-2 mb-3 text-xs font-bold text-gray-500">
      <span class="text-emerald-700 bg-emerald-50 px-2 py-1 rounded-md">{new Date(broadcast.date).toLocaleDateString('ar-EG', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
      <span class="text-orange-600 bg-orange-50 px-2 py-1 rounded-md">{broadcast.category}</span>
    </div>
    <h3 class="text-xl font-black text-emerald-900 mb-2 line-clamp-2 leading-tight group-hover:text-emerald-700 transition-colors">{broadcast.title}</h3>
    <p class="text-sm text-gray-600 line-clamp-2 mb-6 flex-grow">{broadcast.description}</p>
    
    <div class="flex items-center gap-4 text-xs text-gray-500 border-t pt-3 mt-auto">
      {broadcast.images && broadcast.images.length > 0 && (
        <span class="flex items-center gap-1">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
          {broadcast.images.length} صور
        </span>
      )}
      <span class="flex items-center gap-1">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
        {broadcast.presenter}
      </span>
    </div>
  </div>
</a>
