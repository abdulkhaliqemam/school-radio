---
import { toImageUrl } from '../lib/driveHelpers';

interface Props {
  imageIds: string[];
}

const { imageIds } = Astro.props;
---

{imageIds && imageIds.length > 0 && (
  <section class="mt-12">
    <h2 class="text-2xl font-bold mb-6 flex items-center gap-2">
      <svg class="w-6 h-6 text-teal-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
      من كواليس الإذاعة
    </h2>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      {imageIds.map((id) => (
        <a href={toImageUrl(id, 1200)} target="_blank" class="block aspect-square rounded-xl overflow-hidden bg-gray-100 hover:shadow-md transition-shadow">
          <img 
            src={toImageUrl(id, 400)} 
            alt="صورة من كواليس الإذاعة" 
            loading="lazy"
            class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
          />
        </a>
      ))}
    </div>
  </section>
)}
